# URL pública del sitio, sin barra final. Se usa en canonical, hreflang, Open Graph y sitemap.
SITE_URL=https://greenova.vercel.app
# Endpoint que recibe el formulario de contacto (POST JSON). Ejemplo: https://formspree.io/f/xxxxxxx
# Si se deja vacío, el formulario valida pero muestra que el envío está pendiente de configuración.
VITE_FORM_ENDPOINT=
# Asistente con IA (solo en el servidor, nunca con prefijo VITE_). Clave de Google AI Studio.
GEMINI_API_KEY=
# Opcional. Modelo de Gemini; por defecto gemini-3.5-flash-lite.
GEMINI_MODEL=
